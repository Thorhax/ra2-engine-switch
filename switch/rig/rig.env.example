# Copy to switch/rig/rig.env (Git ignores it). Plain KEY=value lines (sourced by sh, parsed by rigenv.py).
# sys-botbase has no authentication: LAN only, never port-forward it.
SWITCH_IP=192.168.1.x
SB_PORT=6000
# FTP server on the Switch (ftpsrv or similar)
FTP_PORT=5000
FTP_USER=
FTP_PASS=
PC_IP=192.168.1.y
# nxlink from devkitPro's switch-tools
NXLINK=/opt/devkitpro/tools/bin/nxlink
# Where runs are kept (default: ra2-logs beside the checkout); scratch files (default: <RA2_LOGS>/tmp)
#RA2_LOGS=
#RIG_TMP=
